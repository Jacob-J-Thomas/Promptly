{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=promptly;Username=promptly;Password=promptly_dev_password"
  },
  "JWT": {
    "Issuer": "Promptly",
    "Audience": "Promptly",
    "ExpiryMinutes": 60
  },
  "DATA_PROTECTION_PATH": "./dataprotection-keys",
  "PROMPTLY_EVAL_BASE_URL": "http://localhost:8000",
  "EndpointEgress": {
    "DnsTimeoutSeconds": 5,
    "ConnectTimeoutSeconds": 10,
    "PooledConnectionLifetimeSeconds": 120,
    "RequireProxy": false,
    "AllowedNonPublicDestinations": []
  },
  "Startup": {
    "ApplyDatabaseMigrations": true
  },
  "TestRunner": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "MaxConcurrentRuns": 2
  }
}
