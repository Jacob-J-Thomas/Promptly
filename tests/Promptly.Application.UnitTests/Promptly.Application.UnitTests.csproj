<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/../Promptly.runsettings</RunSettingsFilePath>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutput>$(MSBuildProjectDirectory)/../../artifacts/test-results/csharp/coverage/coverage</CoverletOutput>
    <CoverletOutputFormat>cobertura,json</CoverletOutputFormat>
    <DeterministicReport>true</DeterministicReport>
    <Include>[Promptly.Application]Promptly.Application.Data.TenantOwnedQueries,[Promptly.Application]Promptly.Application.Data.ExecutableRunQueries,[Promptly.Application]Promptly.Application.Models.EndpointTargetPolicy,[Promptly.Application]Promptly.Application.Models.EndpointTargetValidationException,[Promptly.Application]Promptly.Application.Models.EndpointTargetAttribute,[Promptly.Application]Promptly.Application.Models.EnvironmentBaseUrlValidationException,[Promptly.Application]Promptly.Application.Models.EnvironmentBaseUrlAttribute,[Promptly.Application]Promptly.Application.Models.EndpointDestination*,[Promptly.Application]Promptly.Application.Models.EndpointEgressOptions,[Promptly.Application]Promptly.Application.Models.AllowedNonPublicDestinationRule,[Promptly.Application]Promptly.Application.Services.EndpointDestinationGuard,[Promptly.Application]Promptly.Application.Services.EndpointExecutor*,[Promptly.Application]Promptly.Application.Services.ExpectationEvaluator,[Promptly.Application]Promptly.Application.Services.BoundedRegexMatcher,[Promptly.Application]Promptly.Application.Services.ExpectationDslValidator,[Promptly.Application]Promptly.Application.Interfaces.ExpectationValidationIssue,[Promptly.Application]Promptly.Application.Interfaces.ExpectationValidationResult,[Promptly.Application]Promptly.Application.Services.ProjectService*,[Promptly.Application]Promptly.Application.Services.EnvironmentService*,[Promptly.Application]Promptly.Application.Services.EndpointService*,[Promptly.Application]Promptly.Application.Services.MappingService*,[Promptly.Application]Promptly.Application.Services.MappingSpecValidationException,[Promptly.Application]Promptly.Application.Services.TestSuiteService*,[Promptly.Application]Promptly.Application.Services.TestCaseService*,[Promptly.Application]Promptly.Application.Services.TestRunService*,[Promptly.Application]Promptly.Application.Services.TestRunWorkerStore*,[Promptly.Application]Promptly.Application.Services.TestRunProcessor*,[Promptly.Infrastructure]*,[Promptly.Server]Promptly.Server.Models.AuthenticationInputLimits,[Promptly.Server]Promptly.Server.Models.RegisterRequest,[Promptly.Server]Promptly.Server.Models.LoginRequest,[Promptly.Server]Promptly.Server.Models.AuthResponse,[Promptly.Server]Promptly.Server.Models.UserInfo,[Promptly.Server]Promptly.Server.Security.Tenant*,[Promptly.Server]Promptly.Server.Security.HttpContextTenantAccessScopeAccessor,[Promptly.Server]Promptly.Server.Security.Authentication*,[Promptly.Server]Promptly.Server.Security.IdentityCredentialVerifier*,[Promptly.Server]Promptly.Server.Security.InvalidCredentialPasswordVerifier,[Promptly.Server]Promptly.Server.Services.TestRunWorkerService*,[Promptly.Server]Promptly.Server.Controllers.AuthController*,[Promptly.Server]Promptly.Server.Controllers.ProjectsController*,[Promptly.Server]Promptly.Server.Controllers.EnvironmentsController*,[Promptly.Server]Promptly.Server.Controllers.EndpointsController*,[Promptly.Server]Promptly.Server.Controllers.MappingController*,[Promptly.Server]Promptly.Server.Controllers.TestSuitesController*,[Promptly.Server]Promptly.Server.Controllers.TestsController*,[Promptly.Server]Promptly.Server.Controllers.RunsController*,[Promptly.Cli]Promptly.Cli.RunExitCodePolicy</Include>
    <Threshold>90</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>minimum</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Promptly.Application/Promptly.Application.csproj" />
    <ProjectReference Include="../../Promptly.Cli/Promptly.Cli.csproj" />
    <ProjectReference Include="../../Promptly.Infrastructure/Promptly.Infrastructure.csproj" />
    <ProjectReference Include="../../Promptly.Server/Promptly.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
